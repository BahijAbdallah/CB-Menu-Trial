# ── Session ───────────────────────────────────────────────────────────────
SESSION_SECRET=replace-with-a-long-random-string

# ── Database (Neon Postgres) ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ── Cloudflare R2 (object storage for menu images) ────────────────────────
# Omit these entirely in local dev and images fall back to ./uploads on disk.
#
# R2_ACCOUNT_ID    Account-wide. Same value for every project in your
#                  Cloudflare account. Dashboard home page, right sidebar.
# R2_BUCKET        Project-specific. Do not reuse another project's bucket.
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY
#                  From R2 > API > Manage API Tokens. Scope the token to
#                  this bucket only ("Object Read & Write" > specify bucket)
#                  so a leak here cannot reach your other buckets.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET=cb-menu
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# ── Local dev only ────────────────────────────────────────────────────────
# Where images are written when R2 is not configured. Defaults to ./uploads
# UPLOAD_ROOT=/var/data
